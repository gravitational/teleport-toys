# Rendered by setup_pi.sh -> /etc/teleport.yaml
version: v3
teleport:
  nodename: __NAME__
  data_dir: /var/lib/teleport
  proxy_server: __PROXY__
  join_params:
    method: token
    token_name: /var/lib/teleport/join-token
  log:
    output: stderr
    severity: INFO

auth_service:
  enabled: false
proxy_service:
  enabled: false

# SSH: admin access + session recordings of humans debugging the robot
ssh_service:
  enabled: true
  labels:
    robot: __ROBOT__
    robot-role: __ROLE__
    hw: __HW__

# MCP: the robot's capabilities, exposed only through Teleport
app_service:
  enabled: true
  apps:
    - name: __NAME__
      uri: mcp+http://127.0.0.1:8000/mcp
      description: "BeamBot __ROLE__ node (__HW__)"
      labels:
        robot: __ROBOT__
        robot-role: __ROLE__
        hw: __HW__
      rewrite:
        headers:
          # Teleport-signed identity of the caller (user / beam), logged by the node
          - "Authorization: Bearer {{internal.jwt}}"
