# sudo cp picar-robot.service /etc/systemd/system/ && sudo systemctl enable --now picar-robot
[Unit]
Description=BeamBot PiCar-X MCP + stream server
After=network-online.target

[Service]
User=root
WorkingDirectory=/home/pi/picar-beambot/robot
ExecStart=/usr/bin/python3 /home/pi/picar-beambot/robot/robot_mcp.py
Restart=on-failure
# However the server ends (crash, SIGKILL, OOM), the HAT would keep its last PWM duty: zero the motors afterwards.
ExecStopPost=-/usr/bin/python3 -c "from picarx import Picarx; Picarx().stop()"
Environment=MAX_SPEED=40
Environment=OBSTACLE_STOP_CM=20

[Install]
WantedBy=multi-user.target
